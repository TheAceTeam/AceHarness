{
  "name": "@cangjielang/aceharness",
  "version": "1.0.0-rc.13",
  "description": "ACEHarness - Agent Centric Engineering Harness (From Cangjie Team)",
  "scripts": {
    "build:napi-cj": "npm run build --prefix packages/napi-cj",
    "build:cli": "node scripts/build-cli.js",
    "dev:start": "vite dev -c vite.start.config.mts",
    "build:start": "npm run build:cli && vite build -c vite.start.config.mts",
    "start:start": "node --max-old-space-size=8192 scripts/start-tanstack-start.mjs",
    "dev": "npm run dev:start",
    "build": "npm run build:napi-cj && npm run build:start",
    "prune:package-maps": "node scripts/prune-package-maps.js",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','dist-build']) fs.rmSync(p,{recursive:true,force:true});\"",
    "start": "npm run start:start",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "test": "vitest run",
    "test:components": "vitest run tests/components --environment jsdom",
    "test:e2e": "playwright test",
    "wechat:relay": "node scripts/wechat-bridge-relay.mjs",
    "wechat:qr-test": "node scripts/wechat-qr-test-runner.mjs",
    "wechat:official": "node -r ts-node/register -r tsconfig-paths/register scripts/wechat-official.ts",
    "ace": "node ./bin/ace.js",
    "check:runtime:availability": "node ./scripts/check-runtime-availability.mjs",
    "check:runtime:chat": "node ./scripts/check-runtime-chat.cjs",
    "check:runtime:session": "node ./scripts/check-runtime-session.mjs",
    "check:runtime:trace": "node ./scripts/check-runtime-trace.mjs",
    "check:runtime:model-routes": "node ./scripts/check-runtime-model-routes.mjs",
    "check:runtime:old-architecture-boundaries": "node ./scripts/check-runtime-old-architecture-boundaries.mjs",
    "check:runtime:migration-dry-run": "node ./scripts/check-runtime-migration-dry-run.mjs",
    "check:runtime:consistency": "node ./scripts/check-runtime-consistency.mjs",
    "check:engines": "node ./scripts/check-engine-availability.mjs",
    "check:engine-chat": "node ./scripts/check-engine-chat.cjs",
    "check:workflow-creator": "node ./scripts/check-workflow-creator.cjs",
    "check:batch-report": "node ./scripts/check-batch-report.cjs",
    "check:clarification-qa": "node ./scripts/check-clarification-qa.cjs",
    "check:spec-coding": "node ./scripts/check-spec-coding.cjs",
    "check:spec-then-workflow": "node ./scripts/check-spec-then-workflow.cjs",
    "check:acp": "node ./scripts/check-acp-connectivity.mjs",
    "office:stabilize-sprite": "node scripts/stabilize-office-agent-sprite.mjs",
    "prepack": "npm run build && npm run prune:package-maps",
    "release:tag": "node scripts/release-tag.mjs",
    "publish:npm": "npm publish",
    "publish:beta": "npm publish --tag beta"
  },
  "keywords": [
    "ai",
    "orchestration",
    "claude"
  ],
  "author": "CangjieLang",
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/Cangjie-SIG/ACEHarness.git"
